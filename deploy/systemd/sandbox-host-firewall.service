[Unit]
Description=Sandbox Host isolated guest firewall
Before=sandbox-host-egress.service sandbox-host-runtime.service
After=network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
# The ruleset file is idempotent and atomic, so start and reload are identical
# and never open a gap. Reload preserves the live guest-interface set.
ExecStart=/usr/sbin/nft -f /etc/sandbox-host/nftables.conf
ExecReload=/usr/sbin/nft -f /etc/sandbox-host/nftables.conf
# No ExecStop: intentionally leave the drop rules in force even when the unit is
# stopped, so a stray `systemctl stop` can never fail the firewall open while
# hostile guests are still running. Rules are cleared only by a reboot, after
# which ExecStart reinstalls them before any VM can start.
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
